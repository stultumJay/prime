# DATABASE
DATABASE_URL=postgresql://user:password@db:5432/pme_db

# JWT
JWT_SECRET_KEY=xxx # generate your own secret key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# # CORS
FRONTEND_PME_URL=http://localhost:4173 # vite build port, change to 5173 when using docker to run frontend
# FRONTEND_PME_URL=http://localhost:5173   # --> change the cors to netlify link during production
FRONTEND_DOC_TRACKING_URL=xxx  # input lang during production
FRONTEND_CLEARANCE_URL=xxx  # input lang during production

# INTEGRATION
DOCUMENT_TRACKING_API_BASE_URL=xxx #supabase restful api base url, no web service provided by other team
DOCUMENT_TRACKING_API_KEY=xxx  #supabase published key
EXTERNAL_API_TIMEOUT_SECONDS=10